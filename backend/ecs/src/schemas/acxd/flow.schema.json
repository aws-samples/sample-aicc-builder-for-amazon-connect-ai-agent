{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aicc-builder/acxd/flow.schema.json",
  "title": "ACXD Flow",
  "description": "Contract schema for ACXD flow documents generated by AICC Builder. Mirrors the amazon-connect-acxd-sdk CreateFlow/UpdateFlow payload (AWS devguide acxd-flows). Conservative: fields not documented publicly are restricted; generated flows must validate against this before packaging.",
  "type": "object",
  "required": [
    "flowId",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "flowId": {
      "type": "string",
      "pattern": "^[A-Za-z]{3,64}$",
      "description": "ALPHABETIC ONLY, 3-64 chars. Verified against the live ACXD API 2026-09-05: digits are rejected with 'flowId is not in the expected format' (the public docs' 'alphanumeric' is wrong)."
    },
    "description": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[\\x20-\\x7E]*$",
      "description": "ASCII printable only — the live API rejects non-ASCII (e.g. Korean) with 'description is not in the expected format'. Customer-facing message bodies MAY be non-ASCII."
    },
    "aiDescription": {
      "type": "string",
      "maxLength": 1000,
      "pattern": "^[\\x20-\\x7E\\s]*$",
      "description": "ASCII printable only (live-API verified, same as description)."
    },
    "untrained": {
      "type": "boolean"
    },
    "mainLanguageCode": {
      "type": "string"
    },
    "languageCode": {
      "type": "string"
    },
    "languageCodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "slotTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachedSlot"
      }
    },
    "contextVariables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flowContextVariable"
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "Node ids MUST be UUIDs — the live API rejects other ids with 'nodes is not in the expected format'."
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {
          "$ref": "#/$defs/mcpPort"
        },
        "output": {
          "$ref": "#/$defs/mcpPort"
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "magicLayout": {
      "type": "boolean"
    },
    "saveId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "updatedBy": {
      "type": "string"
    }
  },
  "$defs": {
    "mcpPort": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "type": "object"
        }
      }
    },
    "attachedSlot": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z]{3,30}$",
          "description": "Alphabetic only, 3-30 chars"
        },
        "type": {
          "type": "string"
        },
        "sensitive": {
          "type": "boolean"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aiDescription": {
          "type": "string",
          "maxLength": 1000
        },
        "regex": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "flowContextVariable": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "number",
            "boolean"
          ]
        }
      }
    },
    "message": {
      "type": "object",
      "required": [
        "type",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ssml",
            "text"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "messageId": {
          "type": "string"
        },
        "skipTranslation": {
          "type": "boolean"
        }
      }
    },
    "childNode": {
      "type": "object",
      "required": [
        "nodeId"
      ],
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "generativeCondition": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string"
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "nodeId",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "basic",
            "choice",
            "data_request",
            "define",
            "end",
            "escalate",
            "generative_journey",
            "generative_task",
            "generative_text",
            "intent_capture",
            "knowledge_base",
            "loop",
            "multimodal",
            "note",
            "redirect",
            "split",
            "start",
            "transform",
            "user_choice",
            "user_input",
            "wait"
          ]
        },
        "childNodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/childNode"
          }
        },
        "dataRequests": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "modalities": {
          "type": "object"
        },
        "canvasMetadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "color": {
              "type": "string"
            },
            "pageId": {
              "type": "string"
            }
          }
        },
        "metadata": {
          "type": "object",
          "description": "FlowNodeMetadata (SDK). Keys the SDK does not know are dropped by its serializer and never reach the service, so nothing else is allowed here.",
          "properties": {
            "generativeJourney": {
              "$ref": "#/$defs/generativeJourney"
            },
            "redirect": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "flow",
                    "page",
                    "parent_application"
                  ]
                },
                "flowId": {
                  "type": "string"
                },
                "nodeId": {
                  "type": "string"
                },
                "pageName": {
                  "type": "string"
                }
              }
            },
            "define": {
              "type": "object",
              "required": [
                "name",
                "value"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "$ref": "#/$defs/operand"
                },
                "schema": {},
                "schemaId": {}
              },
              "description": "define node: sets ONE variable. Several assignments are several define nodes."
            },
            "knowledgeBase": {
              "type": "object",
              "description": "KnowledgeBaseNodeConfig — the service requires name (live-verified 2026-09-10); scopeTags is not a field",
              "required": [
                "name",
                "knowledgeBaseId"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "knowledgeBaseId": {
                  "type": "string",
                  "minLength": 1
                },
                "prompt": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "includeCitation": {
                  "type": "boolean"
                },
                "timeout": {
                  "type": "number"
                },
                "minConfidenceScore": {
                  "type": "number"
                },
                "brandId": {
                  "type": "string"
                },
                "filters": {}
              },
              "additionalProperties": false
            },
            "payload": {},
            "nodePayload": {},
            "flowId": {},
            "code": {},
            "choice": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "enum": [
                    "context",
                    "dataRequest",
                    "local",
                    "slotType"
                  ]
                },
                "dataRequestId": {
                  "type": "string"
                },
                "slotTypeId": {
                  "type": "string"
                },
                "localId": {
                  "type": "string"
                },
                "contextVariableKey": {
                  "type": "string"
                },
                "selectedChoiceLabel": {
                  "type": "string"
                },
                "showChoices": {
                  "type": "boolean"
                },
                "disableSingleChoiceAutotraverse": {
                  "type": "boolean"
                },
                "choiceDisplayFormat": {
                  "type": "string",
                  "enum": [
                    "default",
                    "dropdown"
                  ]
                },
                "associatedSlotTypeIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "idField": {
                  "type": "string"
                },
                "labelField": {
                  "type": "string"
                }
              },
              "description": "user_choice configuration: source=slotType + slotTypeId captures a value into the attached slot of that type."
            },
            "generativeText": {},
            "agenticTask": {},
            "loop": {},
            "multimodal": {},
            "note": {},
            "transform": {},
            "tags": {},
            "name": {},
            "interimMessages": {},
            "voiceSettings": {},
            "stateModifications": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "name"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "context",
                      "local",
                      "slot",
                      "system",
                      "variable",
                      "variable_selection"
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "modification": {
                    "type": "string",
                    "enum": [
                      "clear",
                      "custom",
                      "decrement",
                      "increment",
                      "pop",
                      "push",
                      "set",
                      "shift"
                    ]
                  },
                  "functionName": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "#/$defs/operand"
                  }
                }
              }
            },
            "sendContext": {},
            "timeout": {}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "start"
              }
            }
          },
          "then": {
            "required": [
              "childNodes"
            ],
            "properties": {
              "childNodes": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "end"
              }
            }
          },
          "then": {
            "properties": {
              "childNodes": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "data_request"
              }
            }
          },
          "then": {
            "required": [
              "dataRequests"
            ],
            "properties": {
              "dataRequests": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "choice",
                  "split",
                  "user_choice"
                ]
              }
            }
          },
          "then": {
            "required": [
              "childNodes"
            ],
            "properties": {
              "childNodes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "operand": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "captured_flow",
            "captured_intent",
            "computed",
            "constant",
            "constant_id",
            "context",
            "field",
            "json",
            "knowledge_base_metadata",
            "local",
            "node_status",
            "random_number",
            "recursive",
            "slot",
            "slot_value_id",
            "system",
            "variable",
            "variable_selection"
          ]
        },
        "name": {
          "type": "string"
        },
        "value": {},
        "id": {
          "type": "string"
        }
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "left",
        "operator"
      ],
      "properties": {
        "left": {
          "$ref": "#/$defs/operand"
        },
        "right": {
          "$ref": "#/$defs/operand"
        },
        "operator": {
          "type": "string",
          "enum": [
            "contains",
            "eq",
            "exists",
            "gt",
            "gte",
            "lt",
            "lte",
            "matches_regex",
            "neq",
            "not_contains",
            "not_exists",
            "prefix",
            "similar",
            "suffix"
          ]
        }
      }
    },
    "generativeJourneyTool": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "dataRequest",
            "flow",
            "knowledgeBase",
            "mcpFlow",
            "modality"
          ]
        },
        "knowledgeBaseId": {
          "type": "string"
        },
        "flowId": {
          "type": "string"
        },
        "modalityId": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "scopeTags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataRequest": {
          "type": "object",
          "properties": {
            "dataRequestId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "alwaysRetrigger": {
              "type": "boolean"
            }
          }
        },
        "interimMessages": {
          "type": "array"
        }
      }
    },
    "generativeJourney": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "modelType": {
          "type": "string",
          "enum": [
            "amazon-nova-2-lite",
            "amazon-nova-micro",
            "anthropic.claude-haiku-4-5",
            "anthropic.claude-sonnet-5"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generativeJourneyTool"
          }
        },
        "exitConditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              }
            }
          }
        },
        "enableZeroTurnMode": {
          "type": "boolean"
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
