{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aicc-builder/acxd/guardrail.schema.json",
  "title": "ACXD Guardrail",
  "description": "Contract schema for ACXD guardrails (AWS devguide acxd-guardrails).",
  "type": "object",
  "required": ["name", "trigger", "rules"],
  "additionalProperties": false,
  "properties": {
    "guardrailId": { "type": "string" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "trigger": { "type": "string", "enum": ["input", "output"] },
    "description": { "type": "string", "maxLength": 100 },
    "active": { "type": "boolean" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/rule" }
    },
    "fallbackBehavior": { "$ref": "#/$defs/fallbackBehavior" },
    "metadata": { "type": "object" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "lastUpdatedBy": { "type": "string" }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["name", "detection", "enforcement"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 100 },
        "detection": { "$ref": "#/$defs/detection" },
        "enforcement": { "$ref": "#/$defs/enforcement" },
        "active": { "type": "boolean" },
        "stateModifications": { "type": "array", "items": { "type": "object" } },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/tagRef" } }
      }
    },
    "tagRef": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": { "label": { "type": "string", "minLength": 1 } }
    },
    "detection": {
      "type": "object",
      "required": ["method"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["regex", "keyword", "llmJudge"] },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 200 },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "type": "string", "minLength": 1, "maxLength": 50 }
        },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "regex" } } },
          "then": { "required": ["pattern"] }
        },
        {
          "if": { "properties": { "method": { "const": "keyword" } } },
          "then": { "required": ["keywords"] }
        },
        {
          "if": { "properties": { "method": { "const": "llmJudge" } } },
          "then": { "required": ["prompt"] }
        }
      ]
    },
    "enforcement": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": { "type": "string", "enum": ["mask", "modify", "route", "flag"] },
        "behavior": { "$ref": "#/$defs/behavior" },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/tagRef" } }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "route" } } },
          "then": {
            "required": ["behavior"],
            "properties": { "behavior": { "required": ["flowId"] } }
          }
        },
        {
          "$comment": "Live (2026-09-16): a 'modify' rule without behavior.message/prompt is rejected by the service as 'rules[0].enforcement.action is not a supported value'. The SDK documents message and prompt as mutually exclusive.",
          "if": { "properties": { "action": { "const": "modify" } } },
          "then": {
            "required": ["behavior"],
            "properties": {
              "behavior": {
                "oneOf": [
                  { "required": ["message"], "not": { "required": ["prompt"] } },
                  { "required": ["prompt"], "not": { "required": ["message"] } }
                ]
              }
            }
          }
        }
      ]
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maskChar": { "type": "string", "minLength": 1, "maxLength": 1 },
        "maskText": { "type": "string", "maxLength": 50 },
        "message": { "type": "string", "maxLength": 500 },
        "prompt": { "type": "string", "maxLength": 1000 },
        "flowId": { "type": "string" }
      }
    },
    "fallbackBehavior": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["continue", "routeToFlow"] },
        "flowId": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "routeToFlow" } } },
          "then": { "required": ["flowId"] }
        }
      ]
    }
  }
}
