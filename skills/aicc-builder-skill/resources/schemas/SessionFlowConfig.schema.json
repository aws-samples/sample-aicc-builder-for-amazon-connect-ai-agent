    "NoResponsePolicy": {
      "additionalProperties": true,
      "description": "Policy for handling no-response situations.",
      "properties": {
        "max_retries": {
          "default": 2,
          "title": "Max Retries",
          "type": "integer"
        },
        "retry_message": {
          "default": "\uc8c4\uc1a1\ud569\ub2c8\ub2e4. \uc798 \ub4e4\ub9ac\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \ud55c \ubc88 \ub9d0\uc500\ud574 \uc8fc\uc138\uc694.",
          "title": "Retry Message",
          "type": "string"
        },
        "final_message": {
          "default": "\uc751\ub2f5\uc774 \uc5c6\uc5b4 \ub098\uc911\uc5d0 \ub2e4\uc2dc \uc5f0\ub77d\ub4dc\ub9ac\uaca0\uc2b5\ub2c8\ub2e4.",
          "title": "Final Message",
          "type": "string"
        },
        "final_action": {
          "default": "complete",
          "description": "'complete' | 'escalate'",
          "title": "Final Action",
          "type": "string"
        }
      },
      "title": "NoResponsePolicy",
      "type": "object"
    },
    "ToolSpec": {
      "additionalProperties": true,
      "description": "Individual tool definition within an Operation. Each tool = 1 Lambda + 1 API path.",
      "properties": {
        "tool_id": {
          "description": "Tool identifier (e.g., 'notify_customs_clearance_status')",
          "title": "Tool Id",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "role": {
          "default": "primary",
          "description": "'primary' | 'helper' | 'session'",
          "title": "Role",
          "type": "string"
        },
        "http_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "POST",
          "title": "Http Method"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "API path (auto: /tools/{tool_id})",
          "title": "Path"
        },
        "input_fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FieldSpec"
          },
          "title": "Input Fields",
          "type": "array"
        },
        "output_fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FieldSpec"
          },
          "title": "Output Fields",
          "type": "array"
        },
        "data_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataSourceSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trigger_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When to use this tool (e.g., '\uc774\uba54\uc77c \ubbf8\uc218\uc2e0 \uc2dc')",
          "title": "Trigger Context"
        },
        "validation_rules": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Rules"
        },
        "error_handling": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'retry_once' | 'retry_3' | 'escalate' | 'ignore'",
          "title": "Error Handling"
        },
        "generate_lambda": {
          "default": true,
          "title": "Generate Lambda",
          "type": "boolean"
        },
        "generate_openapi": {
          "default": true,
          "title": "Generate Openapi",
          "type": "boolean"
        }
      },
      "required": [
        "tool_id"
      ],
      "title": "ToolSpec",
      "type": "object"
    }
