{
  "name": "aicc-builder-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e --port 5179 --strictPort --no-open",
    "dev:e2e-login": "vite --mode e2e-login --port 5180 --strictPort --no-open",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "test:e2e:auth": "RUN_REAL=1 playwright test --project=setup --headed",
    "test:e2e": "RUN_REAL=1 playwright test --project=real",
    "test:e2e:real": "RUN_REAL=1 playwright test --project=real",
    "test:e2e:smoke": "RUN_REAL=1 playwright test --project=real e2e/real/smoke.spec.ts e2e/real/protocol.spec.ts",
    "test:e2e:headed": "RUN_REAL=1 playwright test --project=real --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:mock": "playwright test --project=hermetic --project=login"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity": "^3.700.0",
    "@dagrejs/dagre": "^1.1.8",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@xyflow/react": "^12.11.1",
    "amazon-cognito-identity-js": "^6.3.0",
    "clsx": "^2.1.0",
    "dompurify": "^3.3.3",
    "lucide-react": "^0.460.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^6.28.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1075.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.16.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
