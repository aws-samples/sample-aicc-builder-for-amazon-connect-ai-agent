# AICC Builder — E2E env for the LOGIN page only.
#
# Identical to .env.e2e EXCEPT it does NOT set VITE_DEV_AUTH, so Cognito is NOT
# bypassed and the /login route actually renders (under the bypass the app
# auto-authenticates and redirects away from /login). With no Cognito config,
# checkIsAuthenticated() returns false → the login form shows. The login spec
# only exercises client-side behavior (i18n, password-policy checklist,
# show/hide, the local "enter credentials" validation) — it never submits to a
# real user pool. Safe to commit; points at no real resource.
VITE_WS_MODE=alb
VITE_SESSION_API_URL=
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
VITE_COGNITO_REGION=ap-northeast-2
